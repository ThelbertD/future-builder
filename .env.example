# ---------------------------------------------------------------------------
# Supabase — public values, safe to expose to the browser
# Project dashboard → Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Supabase — server only. NEVER prefix with NEXT_PUBLIC and never commit.
# Used by the seed script and any trusted background job.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Account that should own the seeded demo workspace. Sign up in the app first,
# then run: npm run seed
SEED_OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Email provider (server only) — required before outreach drafts can send.
#
# Option A: SMTP. The only way to send *as* a @gmail.com address.
#   Gmail needs two-step verification on, then an App Password
#   (myaccount.google.com -> Security -> App passwords). Host and port are
#   inferred for Gmail; set them explicitly for any other provider.
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=
# SMTP_PORT=
#
# Option B: Resend, once you send from your own verified domain.
RESEND_API_KEY=
#
# The address outreach is sent from. Must be an address you control.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# AI providers — server only, used by route handlers
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# "true"  → run entirely on the bundled demo dataset (no database needed)
# "false" → read from Supabase (requires the two public values above)
NEXT_PUBLIC_USE_MOCK_DATA=true

# Public scheduling link included in outreach drafts. Editable per workspace
# in Settings once migration 0005 has run; this is the fallback.
NEXT_PUBLIC_BOOKING_URL=
